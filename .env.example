# Replace this dummy value manually before any OpenRouter-backed command.
USE_OPENROUTER=1
OPENROUTER_API_KEY=DUMMY_REPLACE_WITH_OPENROUTER_KEY

# Hawk hackathon deployment. Hawk login credentials are cached by the Hawk CLI
# and must never be stored in this file.
HAWK_API_URL=https://api.hawk.hackathon.redwood-hawk.com
CT_IMAGE_REGISTRY_PREFIX=linuxarena

# This quickstart installs Control Tower as a dependency rather than running
# from a Control Tower checkout. Pin Hawk to the installed Control Tower commit.
HAWK_CT_REF=0399b0a846ea2bf53f17624e17494008c13a5d38
HAWK_ENV_TAG=latest

# Optional only when private Docker Hub images are required.
# DOCKERHUB_USERNAME=REPLACE_WITH_DOCKERHUB_USERNAME
# DOCKERHUB_TOKEN=REPLACE_WITH_DOCKERHUB_TOKEN
